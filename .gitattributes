# Normalize all text files to LF in the repo and on checkout.
# Prevents Windows editors reintroducing CRLF churn that makes
# `git status` unusable as a pre-push safety check.
* text=auto eol=lf

# Explicit text types
*.html   text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.js     text eol=lf

# Binary assets - never touch these
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pdf    binary
